# TG-BUCKET base URL (no trailing slash)
BUCKET_URL=https://tg-bucketnpm-instal.onrender.com

# TG-BUCKET API key
API_KEY=your_api_key_here

# Size of each test object.
# Keep this below your bucket's per-object limit.
# Example: 1.4 GiB = 1503238553 bytes
FILE_SIZE_BYTES=1503238553

# Optional Telegram alerts
TG_BOT_TOKEN=
TG_CHAT_ID=
