# Required: Your bucket endpoint
BUCKET_URL=https://your-bucket-endpoint.com

# Required: Your bucket API key
API_KEY=your_api_key_here

# Optional: File size per upload in bytes
# Default: 524288000 (500MB)
# Examples:
#   1GB = 1073741824
#   5GB = 5368709120
FILE_SIZE_BYTES=524288000

# Optional: Telegram bot token for failure alerts
# Get from @BotFather on Telegram
TG_BOT_TOKEN=

# Optional: Your Telegram chat ID for alerts
# Send a message to your bot, then visit:
# https://api.telegram.org/bot<TG_BOT_TOKEN>/getUpdates
TG_CHAT_ID=
